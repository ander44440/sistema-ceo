CEO_LLM_API_KEY=
# Opcional — padrão OpenAI
CEO_LLM_BASE_URL=https://api.openai.com/v1
CEO_LLM_MODEL=gpt-4o-mini

# Alternativa aceite pelo servidor:
# OPENAI_API_KEY=

# Só local: se Node falhar com UNABLE_TO_VERIFY_LEAF_SIGNATURE (antivírus/proxy SSL),
# descomente a linha abaixo e reinicie `npm run dev`. Não use em produção.
# CEO_LLM_TLS_INSECURE=1

# BP-001 E8 — Backend de Produção (Hono). Vazio = fetch relativo (Vite plugins).
# Ex.: VITE_CEO_API_BASE=http://localhost:8787
# VITE_CEO_API_BASE=
